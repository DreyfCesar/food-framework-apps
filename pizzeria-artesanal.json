            {
                "icon": "leaf",
                "title": "Ingredientes frescos",
                "description": "Tomates, albahaca, vegetales y quesos seleccionados para cada receta."
            },
            {
                "icon": "clock",
                "title": "Masa 48 horas",
                "description": "Fermentación lenta para conseguir una masa liviana, sabrosa y fácil de disfrutar."
